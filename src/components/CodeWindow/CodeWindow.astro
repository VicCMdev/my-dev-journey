---
import { buildLines, DEFAULT_COLUMNS } from "./codeLines";

const lines = buildLines(DEFAULT_COLUMNS);
---

<div class="code-window" role="img" aria-label="Code snippet describing Victor Ceja as a developer object">
  <div class="code-window-titlebar">
    <div class="dots"><span></span><span></span><span></span></div>
    <div class="code-window-path">
      ~/victor-ceja/profile.ts
    </div>
    <div class="code-window-spacer" aria-hidden="true"></div>
  </div>
  <div class="code-window-pane">
    <div class="code" data-columns={DEFAULT_COLUMNS}>
      {
        lines.map((line) => (
          <div class:list={["line", line.cls]}>
            {line.tokens.map((t) =>
              t.cls ? <span class={t.cls}>{t.text}</span> : t.text,
            )}
          </div>
        ))
      }
    </div>
  </div>
  {
    Astro.slots.has("default") && (
      <div class="button-container">
        <slot />
      </div>
    )
  }
</div>

<style>
  .code-window {
    width: 100%;
    min-width: 0;
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border-strong);
    overflow: hidden;
    box-shadow: 10px 10px 0 var(--color-bg-raised);
  }

  .code-window-titlebar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 13px 16px;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .dots {
    display: flex;
    gap: 7px;
  }

  .dots span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-border);
  }

  .dots span:nth-child(1) {
    background: #ec6a5e;
    opacity: 0.85;
  }
  .dots span:nth-child(2) {
    background: #f4bf4f;
    opacity: 0.85;
  }
  .dots span:nth-child(3) {
    background: #61c554;
    opacity: 0.85;
  }

  .code-window-path {
    flex: 1;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .code-window-spacer {
    width: 46px;
  }

  .code-window-pane {
    padding: 16px;
  }

  .code {
    counter-reset: line;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 16px 0;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.75;
    overflow-x: auto;
  }

  /* Lines never wrap on their own: the script re-wraps the content so each
     visual row is a numbered line, like a real editor. */
  .code :global(.line) {
    counter-increment: line;
    padding: 0 18px 0 0;
    white-space: pre;
  }

  .code :global(.line)::before {
    content: counter(line);
    display: inline-block;
    width: 2.4em;
    margin-right: 1.1em;
    text-align: right;
    color: var(--color-text-muted);
    opacity: 0.8;
    user-select: none;
  }

  .code :global(.line.blank)::before {
    opacity: 0.3;
  }

  .code :global(.kw) {
    color: var(--code-accent);
  }
  .code :global(.str) {
    color: var(--code-accent-2);
  }
  .code :global(.prop) {
    color: var(--color-text);
  }
  .code :global(.pun) {
    color: var(--color-text-muted);
  }
  .code :global(.cmt) {
    color: var(--code-comment);
    font-style: italic;
  }

  .button-container {
    display: flex;
    justify-content: end;
    padding-right: 1.5rem;
    padding-bottom: 1.5rem;
  }

  @media (max-width: 560px) {
    .code-window-pane {
      padding: 16px 12px;
    }
    .code-window-path {
      font-size: 11px;
    }
    .code {
      font-size: 12.5px;
    }
    .code :global(.line)::before {
      width: 1.8em;
      margin-right: 0.8em;
    }
  }
</style>

<script>
  import { buildLines } from "./codeLines";

  function render(code: HTMLElement, columns: number) {
    const fragment = document.createDocumentFragment();
    for (const line of buildLines(columns)) {
      const div = document.createElement("div");
      div.className = ["line", line.cls].filter(Boolean).join(" ");
      for (const token of line.tokens) {
        if (token.cls) {
          const span = document.createElement("span");
          span.className = token.cls;
          span.textContent = token.text;
          div.append(span);
        } else {
          div.append(token.text);
        }
      }
      fragment.append(div);
    }
    code.replaceChildren(fragment);
    code.dataset.columns = String(columns);
  }

  /** How many monospace characters fit in a line after the line-number gutter. */
  function measureColumns(code: HTMLElement): number {
    const line = code.querySelector<HTMLElement>(".line");
    if (!line) return 0;

    const probe = document.createElement("span");
    probe.textContent = "0".repeat(100);
    probe.style.cssText = "position:absolute;visibility:hidden;white-space:pre";
    line.append(probe);
    const charWidth = probe.getBoundingClientRect().width / 100;
    probe.remove();

    const lineStyle = getComputedStyle(line);
    const gutter = getComputedStyle(line, "::before");
    const available =
      code.clientWidth -
      parseFloat(lineStyle.paddingRight) -
      parseFloat(gutter.width) -
      parseFloat(gutter.marginRight);

    return Math.floor(available / charWidth);
  }

  document.querySelectorAll<HTMLElement>(".code-window .code").forEach((code) => {
    const update = () => {
      const columns = measureColumns(code);
      if (columns > 0 && String(columns) !== code.dataset.columns) {
        render(code, columns);
      }
    };

    new ResizeObserver(update).observe(code);
    // Character width changes once the web font finishes loading.
    document.fonts?.ready.then(update);
  });
</script>
