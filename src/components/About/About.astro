---
import CodeWindow from "@components/CodeWindow/CodeWindow.astro";
import SectionHeading from "@components/Section/SectionHeading.astro";
import { profile } from "../../data/profile";
import { getSectionIndex } from "../../util/sectionCounter";

const aboutIndex = getSectionIndex("about") ?? "01";
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionHeading index={aboutIndex} title="About me" id="about-title" />
    <div class="about-grid">
      <div class="about-text">
        {profile.about.map((p, i) => <p class:list={{ first: i === 0 }}>{p}</p>)}
      </div>
      <CodeWindow />
    </div>
  </div>
</section>

<style>
  .about {
    padding: clamp(4rem, 3rem + 4vw, 6.5rem) 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    align-items: start;
  }

  .about-text p {
    margin: 0 0 1.25rem;
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .about-text p.first {
    font-size: var(--fs-lead);
    color: var(--color-text);
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
