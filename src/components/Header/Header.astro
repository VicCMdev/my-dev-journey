---
import Feature from "../Feature/Feature.astro";
---

<header class="site-header">
    <div class="container">
      <a class="logo" href="/home"><span id="logo-typed" data-text="Victor Ceja"></span><span class="logo-cursor" aria-hidden="true"></span></a>
      <nav>
        <ul>
          <li><a href="/home">Home</a></li>
          <li><a href="/home#about">About Me</a></li>
          <Feature feature="projects"> <li><a href="/projects">Projects</a></li></Feature>
          <Feature feature="contact"> <li><a href="/contact">Contact</a></li></Feature>
        </ul>
      </nav>
    </div>
</header>

<style>
    header.site-header {
  border-bottom: 1px solid var(--color-border);
  padding: 1.25rem 0;
}

.site-header .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.site-header .logo {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 1.1rem;
  color: var(--color-text);
}

.site-header .logo:hover {
  text-decoration: none;
}

.logo-cursor {
  display: inline-block;
  width: 2px;
  height: 1em;
  margin-left: 3px;
  background: var(--code-accent);
  animation: cursor-blink 1s step-end infinite;
}

@keyframes cursor-blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .logo-cursor {
    animation: none;
  }
}

.site-header nav ul {
  list-style: none;
  display: flex;
  gap: 1.5rem;
  margin: 0;
  padding: 0;
}

.site-header nav a {
  color: var(--color-text-muted);
  font-weight: 500;
}

.site-header nav a:hover,
.site-header nav a.active {
  color: var(--color-text);
  text-decoration: none;
}

@media (max-width: 600px) {
  .site-header .container {
    flex-direction: column;
    gap: 0.75rem;
  }
}
</style>

<script>
 const logoTyped = document.getElementById("logo-typed");
  if (logoTyped) {
    const fullText = logoTyped.dataset.text || logoTyped.textContent;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) {
      logoTyped.textContent = fullText;
    } else {
      logoTyped.textContent = "";
      let i = 0;
      (function typeNext() {
        if (i <= fullText.length) {
          logoTyped.textContent = fullText.slice(0, i);
          i++;
          setTimeout(typeNext, 90);
        }
      })();
    }
  }
</script>