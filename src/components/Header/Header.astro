---
import { isFlagEnabled } from "../../config/flags";
import { getNavSections } from "../../util/sectionCounter";

const path = Astro.url.pathname.replace(/\/$/, "");
const contactEnabled = isFlagEnabled("contact");
const navSections = getNavSections();
---

<header class="site-header">
  <div class="container">
    <a class="logo" href="/home" aria-label="Victor Ceja — home">
      <span id="logo-typed" data-text="<VCM/>">&lt;VCM/&gt;</span><span
        class="logo-cursor"
        aria-hidden="true"></span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          navSections.map((section) => (
            <li>
              <a href={section.href} aria-current={path === section.href ? "page" : undefined}>
                <span>{`${section.index}.`}</span> {section.label}
              </a>
            </li>
          ))
        }
      </ul>
      {
        contactEnabled && (
          <a class="hire" href="/contact">
            Hire me
          </a>
        )
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 20, 22, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.75rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--color-accent);
    min-width: 6.5ch;
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 4px;
    background: var(--color-accent);
    animation: cursor-blink 1s step-end infinite;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  ul {
    list-style: none;
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
  }

  ul a {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
  }

  ul a span {
    color: var(--color-accent);
  }

  ul a:hover,
  ul a[aria-current="page"] {
    color: var(--color-text);
    text-decoration: none;
    border-bottom-color: var(--color-accent);
  }

  .hire {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.55rem 1rem;
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .hire:hover {
    text-decoration: none;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  @media (max-width: 860px) {
    .container {
      flex-wrap: wrap;
      padding-top: 0.85rem;
      padding-bottom: 0.85rem;
    }

    nav {
      width: 100%;
      justify-content: space-between;
      gap: 1rem;
    }

    ul {
      gap: 1rem;
      overflow-x: auto;
    }

    ul a span {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .hire {
      display: none;
    }
  }
</style>

<script>
  const logoTyped = document.getElementById("logo-typed");
  if (logoTyped) {
    const fullText = logoTyped.dataset.text || logoTyped.textContent || "";
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduceMotion) {
      logoTyped.textContent = "";
      let i = 0;
      (function typeNext() {
        if (i <= fullText.length) {
          logoTyped.textContent = fullText.slice(0, i);
          i++;
          setTimeout(typeNext, 110);
        }
      })();
    }
  }
</script>
