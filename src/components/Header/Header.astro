---
import { isFlagEnabled } from "../../config/flags";
import { getNavSections } from "../../util/sectionCounter";
import { url } from "@util/urlFixer";

const path = Astro.url.pathname.replace(/\/$/, "");
const contactEnabled = isFlagEnabled("contact");
const navSections = getNavSections();
---

<!-- Runs before the header paints so there is no flash of the no-JS fallback -->
<script is:inline>
  document.documentElement.classList.add("js");
</script>

<header class="site-header" data-menu-open="false">
  <div class="container">
    <a class="logo" href={url("/home")} aria-label="Victor Ceja — home">
      <span id="logo-typed" data-text="<VCM/>">&lt;VCM/&gt;</span><span
        class="logo-cursor"
        aria-hidden="true"></span>
    </a>

    <!-- Hamburger: only visible on small screens (see media query) -->
    <button
      class="menu-toggle"
      type="button"
      aria-controls="main-nav"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <i class="fa-solid fa-bars fa-xl icon-open" aria-hidden="true"></i>
      <i class="fa-solid fa-xmark fa-xl icon-close" aria-hidden="true"></i>
    </button>

    <nav id="main-nav" class="main-nav" aria-label="Main">
      <ul>
        {
          navSections.map((section) => (
            <li>
              <a
                href={url(section.href)}
                aria-current={path === url(section.href) ? "page" : undefined}
              >
                <span>{`${section.index}.`}</span> {section.label}
              </a>
            </li>
          ))
        }
      </ul>
      {
        contactEnabled && (
          <a class="hire" href={url("/contact")}>
            Hire me
          </a>
        )
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 20, 22, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.75rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--color-accent);
    min-width: 6.5ch;
    position: relative;
    z-index: 2;
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 4px;
    background: var(--color-accent);
    animation: cursor-blink 1s step-end infinite;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  /* ---------- Desktop nav ---------- */

  .main-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  ul {
    list-style: none;
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
  }

  ul a {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
  }

  ul a span {
    color: var(--color-accent);
  }

  ul a:hover,
  ul a[aria-current="page"] {
    color: var(--color-text);
    text-decoration: none;
    border-bottom-color: var(--color-accent);
  }

  .hire {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.55rem 1rem;
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .hire:hover {
    text-decoration: none;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  /* ---------- Hamburger button ---------- */

  .menu-toggle {
    display: none; /* hidden on desktop */
    position: relative;
    z-index: 2;
    width: 44px; /* 44px = minimum touch target */
    height: 44px;
    padding: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: transparent;
    border: 2px solid var(--color-border-strong);
    cursor: pointer;
  }

  .menu-toggle:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Both icons share the same spot, one on top of the other */
  .menu-toggle i {
    color: var(--color-accent);
    position: absolute;
    transition:
      opacity 0.2s ease,
      transform 0.25s ease;
  }

  /* Closed: show bars */
  .icon-close {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  .icon-open {
    opacity: 1;
    transform: none;
  }
  
  .site-header[data-menu-open="false"] .icon-close {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  /* Open: swap to the X with a small rotation */
  .site-header[data-menu-open="true"] .icon-open {
    display: none;
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  .site-header[data-menu-open="true"] .icon-close {
    opacity: 1;
    transform: none;
  }


  /* Animate the three bars into an "X" when open */
  .site-header[data-menu-open="true"] .bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .site-header[data-menu-open="true"] .bar:nth-child(2) {
    opacity: 0;
  }
  .site-header[data-menu-open="true"] .bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* ---------- Mobile: collapsible panel ---------- */

  @media (max-width: 860px) {
    .menu-toggle {
      display: inline-flex;
    }

    .main-nav {
      position: fixed;
      inset: 4.75rem 0 auto 0; /* sits right under the header */
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
      padding: 1.5rem var(--gutter) 2rem;
      background: var(--color-bg);
      border-bottom: 2px solid var(--color-accent);
      box-shadow: 0 24px 40px -20px rgba(0, 0, 0, 0.7);

      /* closed state */
      visibility: hidden;
      opacity: 0;
      transform: translateY(-12px);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        visibility 0s linear 0.2s;
    }

    .site-header[data-menu-open="true"] .main-nav {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        visibility 0s;
    }

    ul {
      flex-direction: column;
      gap: 0;
    }

    ul li + li {
      border-top: 1px solid var(--color-border);
    }

    ul a {
      display: block;
      padding: 1rem 0;
      font-size: 1.25rem;
      border-bottom: 0;
    }

    ul a:hover,
    ul a[aria-current="page"] {
      color: var(--color-accent);
    }

    .hire {
      text-align: center;
      padding: 0.9rem 1rem;
      font-size: 1rem;
    }
  }

  /* Without JS the toggle can't work, so keep the links visible */
  @media (max-width: 860px) {
    :global(html:not(.js)) .menu-toggle {
      display: none;
    }
    :global(html:not(.js)) .main-nav {
      position: static;
      visibility: visible;
      opacity: 1;
      transform: none;
      padding: 0 0 1rem;
      border: 0;
      box-shadow: none;
    }
  }
</style>

<script>
  /* ---------- Typed logo ---------- */
  const logoTyped = document.getElementById("logo-typed");
  if (logoTyped) {
    const fullText = logoTyped.dataset.text || logoTyped.textContent || "";
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (!reduceMotion) {
      logoTyped.textContent = "";
      let i = 0;
      (function typeNext() {
        if (i <= fullText.length) {
          logoTyped.textContent = fullText.slice(0, i);
          i++;
          setTimeout(typeNext, 110);
        }
      })();
    }
  }

  /* ---------- Hamburger menu ---------- */
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.getElementById("main-nav");
  const desktop = window.matchMedia("(min-width: 861px)");

  if (header && toggle && nav) {
    const setOpen = (open: boolean) => {
      header.dataset.menuOpen = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      // Prevent the page from scrolling behind the open panel
      document.body.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", () => {
      setOpen(header.dataset.menuOpen !== "true");
    });

    // Close after choosing a link (important for #anchor links on the same page)
    nav.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });

    // Close with Escape and return focus to the button
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && header.dataset.menuOpen === "true") {
        setOpen(false);
        toggle.focus();
      }
    });

    // Close when clicking outside the header
    document.addEventListener("click", (e) => {
      if (
        header.dataset.menuOpen === "true" &&
        !header.contains(e.target as Node)
      ) {
        setOpen(false);
      }
    });

    // Reset if the window grows to desktop size while open
    desktop.addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
