---
import Footer from "@components/Footer/Footer.astro";
import Header from "@components/Header/Header.astro";
import {url} from "@util/urlFixer"

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Victor Ceja — Frontend Engineer",
  description = "Victor Ceja, Associate Software Engineer building fast, accessible web interfaces with React and TypeScript. Available for freelance projects.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B1416" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="icon" href={url("/favicon.ico")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /*
   * Design tokens — "Terminal Brutalist"
   * Palette derived from the VCM favicon (deep teal + cyan).
   * All text pairs meet WCAG AA (≥ 4.5:1); input borders meet 3:1.
   */
  :root {
    --color-bg: #0b1416;
    --color-bg-alt: #0f2a2e;
    --color-bg-raised: #12353a;
    --color-text: #e8f1f0;
    --color-text-muted: #9db3b1;
    --color-accent: #5eead4;
    --color-accent-contrast: #04211d;
    --color-border: #2a4a4e;
    --color-border-strong: #5b8a8e;
    --color-success: #5eead4;
    --color-error: #ff9a8f;

    --code-accent: #5eead4;
    --code-accent-2: #f2c14e;
    --code-comment: #8aa5a3;

    --font-body: "Space Grotesk", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, "Cascadia Code", monospace;

    --fs-display: clamp(2.75rem, 1.4rem + 5.6vw, 5.5rem);
    --fs-h2: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
    --fs-h3: clamp(1.3rem, 1.15rem + 0.6vw, 1.65rem);
    --fs-lead: clamp(1.1rem, 1.02rem + 0.35vw, 1.3rem);

    --shadow-hard: 8px 8px 0 var(--color-accent);
    --max-width: 1200px;
    --gutter: clamp(1rem, 0.5rem + 2.5vw, 3rem);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 6rem;
  }

  body {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  main {
    min-height: 70vh;
  }

  h1,
  h2,
  h3 {
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  a {
    color: var(--color-accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  :focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  img {
    max-width: 100%;
    display: block;
  }

  ::selection {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .skip-link:focus {
    top: 1rem;
  }

  /* ---------- Shared UI primitives ---------- */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.95rem 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    border: 2px solid var(--color-text);
    color: var(--color-text);
    background: transparent;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background-color 0.15s ease;
  }

  .btn:hover {
    text-decoration: none;
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--color-accent);
  }

  .btn:active {
    transform: translate(0, 0);
    box-shadow: none;
  }

  .btn-primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-contrast);
    box-shadow: 6px 6px 0 var(--color-text);
  }

  .btn-primary:hover {
    box-shadow: 9px 9px 0 var(--color-text);
  }

  .chip {
    display: inline-block;
    padding: 0.3rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
