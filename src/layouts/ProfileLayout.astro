---
import Footer from "../components/Footer/Footer.astro";
import Header from "../components/Header/Header.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
    <meta name="generator" content={Astro.generator} />
    <title>VECM</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap");

  :root {
    --color-bg: #0a1020;
    --color-bg-alt: #1b2847;
    --color-bg-raised: #24345c;
    --color-text: #f1f3f9;
    --color-text-muted: #b0bcd6;
    --color-accent: #3457d5;
    --color-accent-contrast: #f1f3f9;
    --color-border: #2f3f66;
    --max-width: 960px;
    --font-body:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial,
      sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;
    --code-accent: #5b7ce8;
    --code-accent-2: #f2a541;
    --code-comment: #8593b8;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 1rem;
    font-family: var(--font-body);
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
    position: relative;
  }

  main {
    padding: 1.5rem 0;
    min-height: 80vh;
  }

  a {
    color: var(--color-accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  img {
    max-width: 100%;
    display: block;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
</style>
