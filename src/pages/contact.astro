---
import ProfileLayout from "@layouts/ProfileLayout.astro";
import SectionHeading from "@components/Section/SectionHeading.astro";
import { profile } from "../data/profile";

const key = import.meta.env.PUBLIC_FORM_KEY;
---

<ProfileLayout
  title="Contact — Victor Ceja"
  description="Get in touch with Victor Ceja for freelance web projects or frontend engineering roles."
>
  <section class="contact" aria-labelledby="contact-title">
    <div class="container contact-grid">
      <div class="intro">
        <SectionHeading index="04" title="Let's build something." id="contact-title" />
        <p class="lead">
          Have a project, a role, or an idea in mind? Tell me a bit about it and
          I'll get back to you — usually within 24 hours.
        </p>

        <ul class="direct">
          <li>
            <span class="eyebrow">E-mail</span>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </li>
          <li>
            <span class="eyebrow">LinkedIn</span>
            <a href={profile.links.linkedin} target="_blank" rel="noopener">Victor Ceja ↗</a>
          </li>
          <li>
            <span class="eyebrow">GitHub</span>
            <a href={profile.links.github} target="_blank" rel="noopener">@VicCMdev ↗</a>
          </li>
        </ul>
      </div>

      <form id="contact-form" class="form" novalidate>
        <input type="hidden" name="access_key" value={key} />
        <input type="hidden" name="subject" value="New message from victorceja portfolio" />
        <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" />

        <div class="field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required autocomplete="name" placeholder="Jane Doe" />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="jane@company.com"
          />
        </div>

        <div class="field full">
          <label for="topic">I'm reaching out about</label>
          <div class="select-wrap">
            <select id="topic" name="topic">
              <option>A freelance project</option>
              <option>A job opportunity</option>
              <option>A collaboration</option>
              <option>Something else</option>
            </select>
          </div>
        </div>

        <div class="field full">
          <label for="message">Message</label>
          <textarea
            id="message"
            name="message"
            required
            placeholder="Tell me about your project, timeline and goals…"></textarea>
        </div>

        <div class="actions full">
          <p id="form-status" class="status" role="status" aria-live="polite"></p>
          <button type="submit" class="btn btn-primary">
            <span class="label">Send message</span> <span aria-hidden="true">→</span>
          </button>
        </div>
      </form>
    </div>
  </section>
</ProfileLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const formStatus = document.getElementById("form-status") as HTMLParagraphElement | null;
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const buttonLabel = button?.querySelector<HTMLSpanElement>(".label");

  const setStatus = (type: "success" | "error" | "", message: string) => {
    if (!formStatus) return;
    formStatus.textContent = message;
    formStatus.classList.remove("success", "error");
    if (type) formStatus.classList.add(type);
  };

  if (form && button && buttonLabel) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.classList.add("was-validated");
        form.reportValidity();
        return;
      }

      buttonLabel.textContent = "Sending…";
      button.classList.add("loading");
      button.disabled = true;
      setStatus("", "");

      const data = Object.fromEntries(new FormData(form));

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          setStatus("success", "Message sent — thanks! I'll get back to you soon.");
          form.reset();
          form.classList.remove("was-validated");
        } else {
          setStatus("error", "Something went wrong. Please try again or e-mail me directly.");
        }
      } catch (error) {
        console.error(error);
        setStatus("error", "Something went wrong. Please try again or e-mail me directly.");
      } finally {
        buttonLabel.textContent = "Send message";
        button.classList.remove("loading");
        button.disabled = false;
        setTimeout(() => setStatus("", ""), 6000);
      }
    });
  }
</script>

<style>
  .contact {
    padding: clamp(3.5rem, 2.5rem + 4vw, 6.5rem) 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 1rem + 4vw, 5rem);
    align-items: start;
  }

  .lead {
    margin: 0;
    font-size: var(--fs-lead);
    color: var(--color-text-muted);
    max-width: 36ch;
  }

  .direct {
    display: grid;
    gap: 1.25rem;
    margin: 2.5rem 0 0;
    padding: 1.5rem 0 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .direct li {
    display: grid;
    gap: 0.15rem;
  }

  .direct a {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    word-break: break-word;
  }

  /* ---------- Form ---------- */

  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 1.25rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border-strong);
    box-shadow: 12px 12px 0 var(--color-accent);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .full {
    grid-column: 1 / -1;
  }

  label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text);
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.9rem 1rem;
    font: inherit;
    font-size: 1rem;
    color: var(--color-text);
    background: var(--color-bg);
    border: 2px solid var(--color-border-strong);
    border-radius: 0;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--code-comment);
  }

  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--color-text-muted);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 4px 4px 0 var(--color-accent);
  }

  .was-validated :is(input, textarea):invalid {
    border-color: var(--color-error);
  }

  .select-wrap {
    position: relative;
  }

  .select-wrap::after {
    content: "▾";
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-accent);
    pointer-events: none;
  }

  select {
    appearance: none;
    padding-right: 2.5rem;
    cursor: pointer;
  }

  textarea {
    min-height: 170px;
    resize: vertical;
  }

  .honeypot {
    display: none;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .status {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .status.success {
    color: var(--color-success);
  }

  .status.error {
    color: var(--color-error);
  }

  .actions .btn {
    margin-left: auto;
  }

  .loading {
    cursor: wait;
    pointer-events: none;
    animation: sending-blink 1.6s ease-in-out infinite;
  }

  @keyframes sending-blink {
    50% {
      opacity: 0.55;
    }
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .form {
      grid-template-columns: 1fr;
      box-shadow: 8px 8px 0 var(--color-accent);
    }

    .actions .btn {
      width: 100%;
    }
  }
</style>
