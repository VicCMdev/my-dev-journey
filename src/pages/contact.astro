---
import ProfileLayout from "@layouts/ProfileLayout.astro";

const key = import.meta.env.PUBLIC_FORM_KEY;
---

<ProfileLayout>
  <div class="container">
    <h1 class="section-title">Contact</h1>
    <p>
      If you have an idea about a project or want to work together, please fill
      out the form below and I'll get back to you as soon as possible. I'm
      thrilled to hear from you!
    </p>

    <form id="contact-form" action="mailto:victorceja.dev@gmail.com">
      <input type="hidden" name="access_key" value={key} />
      <div>
        <label for="name">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="Your Name"
        />
      </div>
      <div>
        <label for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="someone@gmail.com"
        />
      </div>
      <div>
        <label for="message">Message</label>
        <textarea
          id="message"
          name="message"
          required
          placeholder="Contact purpose"></textarea>
      </div>
      <div class="button-container">
        <button type="submit" class="button">Send Message</button>
      </div>
      <p id="form-status"></p>
    </form>
  </div>
</ProfileLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const formStatus = document.getElementById(
    "form-status",
  ) as HTMLParagraphElement;
  const button = form.querySelector(
    'button[type="submit"]',
  ) as HTMLButtonElement;
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      button.textContent = "Sending";
      button.classList.add("loading");
      button.disabled = true;
      formStatus.textContent = "";
      formStatus.classList.remove("success", "error");
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      const dataJson = JSON.stringify(data);

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: dataJson,
        });

        if (response.ok) {
          formStatus.classList.add("success");
          formStatus.textContent = "Message sent successfully!";
          form.reset();
        } else {
          formStatus.classList.add("error");
          formStatus.textContent =
            "Oh no! Something went wrong. Please try again later.";
        }
        button.textContent = "Send Message";
        button.classList.remove("loading");
        button.disabled = false;
      } catch (error) {
        console.error(error);
        formStatus.classList.add("error");
        formStatus.textContent =
          "Oh no! Something went wrong. Please try again later.";
      } finally {
        setTimeout(() => {
          formStatus.textContent = "";
          formStatus.classList.remove("success", "error");
        }, 3000);
      }
    });
  }
</script>

<style>
  :root {
    --color-success: #1ba11b;
    --color-error: #c40505;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 40rem;
    margin-top: 1.5rem;
  }

  form > div {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  input,
  textarea {
    padding: 0.75rem 0.9rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    color: var(--color-text);
    font-family: inherit;
    font-size: 1rem;
    width: 100%;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    background-color: var(--color-bg);
  }

  textarea {
    min-height: 140px;
    resize: vertical;
  }

  form > button {
    align-self: flex-start;
  }

  .button {
    display: inline-block;
    margin-left: 4.5rem;
    margin-top: 1.5rem;
    padding: 0.65rem 1.4rem;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-radius: 6px;
    font-weight: 600;
    border: none;
  }

  .button-container {
    display: flex;
    justify-content: end;
    padding-right: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .button:hover:not(:disabled) {
    text-decoration: none;
    opacity: 0.9;
  }

  .success {
    color: var(--color-success);
  }

  .error {
    color: var(--color-error);
  }

  .loading {
    min-width: 9.5rem;
    cursor: wait;
    pointer-events: none;
    animation: sending-blink 2s ease-in-out infinite;
  }

  @keyframes sending-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.2;
    }
  }
</style>
