---
import ProfileLayout from "@layouts/ProfileLayout.astro";
import SectionHeading from "@components/Section/SectionHeading.astro";

// Placeholder content — replace with real projects before enabling the "projects" flag.
const projects = [
  { title: "Project One", description: "A short description of what this project does and the problem it solves.", tags: ["JavaScript", "HTML/CSS"] },
  { title: "Project Two", description: "A short description of what this project does and the problem it solves.", tags: ["Python", "API"] },
  { title: "Project Three", description: "A short description of what this project does and the problem it solves.", tags: ["React", "Node.js"] },
];
---

<ProfileLayout title="Projects — Victor Ceja">
  <section class="projects" aria-labelledby="projects-title">
    <div class="container">
      <SectionHeading index="03" title="Selected work" id="projects-title" />
      <div class="card-grid">
        {
          projects.map((p, i) => (
            <article class="card">
              <span class="number">{String(i + 1).padStart(2, "0")}</span>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              <ul class="tags">
                {p.tags.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</ProfileLayout>

<style>
  .projects {
    padding: clamp(3.5rem, 2.5rem + 4vw, 6.5rem) 0;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
  }

  .card {
    padding: 1.75rem;
    border: 2px solid var(--color-border);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .card:hover {
    border-color: var(--color-accent);
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-hard);
  }

  .number {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  h3 {
    margin: 0.75rem 0 0;
    font-size: 1.4rem;
  }

  p {
    color: var(--color-text-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
